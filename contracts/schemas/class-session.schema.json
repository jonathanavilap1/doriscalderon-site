{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "class-session.schema.json",
  "title": "ClassSession",
  "description": "Class metadata plus the white-label branding snapshot the TV injects at load time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "class_id",
    "club_id",
    "workout_type",
    "status",
    "title",
    "starts_at",
    "branding",
    "join",
    "realtime"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "class_id": {
      "type": "string",
      "format": "uuid"
    },
    "club_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,39}$"
    },
    "workout_type": {
      "enum": [
        "hyrox",
        "indoor_cycling",
        "hiit"
      ],
      "description": "Drives the TV gamification layout and the award rules."
    },
    "status": {
      "enum": [
        "scheduled",
        "live",
        "completed"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "branding": {
      "$ref": "branding.schema.json"
    },
    "join": {
      "description": "Check-in PIN shown on the TV. Null once expired.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pin",
            "pin_expires_at"
          ],
          "properties": {
            "pin": {
              "type": "string",
              "pattern": "^[0-9]{4}$"
            },
            "pin_expires_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "realtime": {
      "type": "object",
      "description": "Connection hints for MQTT over WebSockets.",
      "additionalProperties": false,
      "required": [
        "iot_endpoint",
        "authorizer"
      ],
      "properties": {
        "iot_endpoint": {
          "type": "string",
          "description": "AWS IoT Data-ATS hostname."
        },
        "authorizer": {
          "type": "string",
          "description": "Name of the IoT custom authorizer."
        }
      }
    }
  }
}
