{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "class-results.schema.json",
  "title": "ClassResults",
  "description": "Final, authoritative results computed by the class-completed Lambda from Timestream. Live TV rankings are estimates; this payload supersedes them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["class_id", "club_id", "workout_type", "generated_at", "podium", "athletes", "awards"],
  "properties": {
    "class_id": { "type": "string", "format": "uuid" },
    "club_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,39}$" },
    "workout_type": { "enum": ["hyrox", "indoor_cycling", "hiit"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "podium": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "athlete_id", "points"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
          "athlete_id": { "type": "string", "format": "uuid" },
          "points": { "type": "number", "minimum": 0 }
        }
      }
    },
    "athletes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["athlete_id", "avg_bpm", "peak_bpm", "minutes_in_zone", "points"],
        "properties": {
          "athlete_id": { "type": "string", "format": "uuid" },
          "avg_bpm": { "type": "integer", "minimum": 0 },
          "peak_bpm": { "type": "integer", "minimum": 0 },
          "points": { "type": "number", "minimum": 0 },
          "minutes_in_zone": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gray", "blue", "green", "orange", "red"],
            "properties": {
              "gray": { "type": "integer", "minimum": 0 },
              "blue": { "type": "integer", "minimum": 0 },
              "green": { "type": "integer", "minimum": 0 },
              "orange": { "type": "integer", "minimum": 0 },
              "red": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["award", "athlete_id"],
        "properties": {
          "award": { "enum": ["podium_gold", "podium_silver", "podium_bronze", "redline_warrior", "consistency_king", "peak_performer"] },
          "athlete_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
